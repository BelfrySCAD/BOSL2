[[test]]
name = "test_nurbs_patch_points"
script = '''
include <../std.scad>
include <../nurbs.scad>

module test_nurbs_patch_points() {
    // Flat 3×3 patch of control points on the XY plane
    patch = [for (i=[0:2]) [for (j=[0:2]) [i*5, j*5, 0]]];
    pts = nurbs_patch_points(patch, degree=2, splinesteps=3);
    // Result is a 2D grid of 3D points
    assert(is_list(pts));
    assert(is_list(pts[0]));
    assert(len(pts[0][0]) == 3);
    // All points should be on the z=0 plane
    for (row = pts, pt = row) assert_approx(pt[2], 0);
}
test_nurbs_patch_points();
'''

[[test]]
name = "test_nurbs_vnf"
script = '''
include <../std.scad>
include <../nurbs.scad>

module test_nurbs_vnf() {
    // Flat 3×3 patch
    patch = [for (i=[0:2]) [for (j=[0:2]) [i*5, j*5, 0]]];
    v = nurbs_vnf(patch, degree=2, splinesteps=3);
    assert(is_vnf(v));
    assert(len(v[0]) > 0);  // has vertices
    assert(len(v[1]) > 0);  // has faces
}
test_nurbs_vnf();
'''



# ---------------------------------------------------------------------
# nurbs_curve_breaks() -- additional coverage beyond the basic clamped case
# ---------------------------------------------------------------------

[[test]]
name = "test_nurbs_curve_breaks_match_curve_evaluation"
script = '''
include <../std.scad>
include <../nurbs.scad>

module test_nurbs_curve_breaks_match_curve_evaluation() {
    // splinesteps=1 samples exactly one point per knot span (plus the final
    // knot), which should land on exactly the same u-values as the public
    // breakpoints -- and thus the same curve points.
    control = [[13,43],[30,52],[49,22],[24,3]];
    degree = 2;
    breaks = nurbs_curve_breaks(control, degree);
    via_breaks      = nurbs_curve(control, degree, u=breaks);
    via_splinesteps = nurbs_curve(control, degree, splinesteps=1);
    assert_approx(via_breaks, via_splinesteps);
}
test_nurbs_curve_breaks_match_curve_evaluation();
'''

[[test]]
name = "test_nurbs_curve_degree1_interpolates_control_points_at_breaks"
script = '''
include <../std.scad>
include <../nurbs.scad>

module test_nurbs_curve_degree1_interpolates_control_points_at_breaks() {
    // A degree-1 clamped B-spline is exactly the piecewise-linear
    // interpolant through its control points, and the breakpoints are
    // exactly the parameter values at which each control point is reached.
    control = [[0,0],[3,4],[6,4],[10,4]];
    degree = 1;
    breaks = nurbs_curve_breaks(control, degree);
    assert_equal(len(breaks), len(control));
    pts = nurbs_curve(control, degree, u=breaks);
    assert_approx(pts, control);
}
test_nurbs_curve_degree1_interpolates_control_points_at_breaks();
'''

[[test]]
name = "test_nurbs_curve_breaks_length_matches_mult_length"
script = '''
include <../std.scad>
include <../nurbs.scad>

module test_nurbs_curve_breaks_length_matches_mult_length() {
    // Each entry of an explicit (clamped) mult vector produces exactly one
    // breakpoint, even where the multiplicity creates a repeated knot.
    pts = [[5,0],[0,20],[33,43],[37,88],[60,62],[44,22],[77,44],[79,22],[44,3],[22,7]];
    mult = [1,1,1,2,1,1,1,1];
    breaks = nurbs_curve_breaks(pts, 2, mult=mult);
    assert_equal(len(breaks), len(mult));
    assert(is_increasing(breaks));
    assert_approx(breaks[0], 0);
    assert_approx(last(breaks), 1);
}
test_nurbs_curve_breaks_length_matches_mult_length();
'''

[[test]]
name = "test_nurbs_curve_breaks_default_length_matches_formula"
script = '''
include <../std.scad>
include <../nurbs.scad>

module test_nurbs_curve_breaks_default_length_matches_formula() {
    control = [[5,0],[0,20],[33,43],[37,88],[60,62],[44,22],[77,44],[79,22],[44,3],[22,7]];
    degree = 4;
    breaks = nurbs_curve_breaks(control, degree);
    assert_equal(len(breaks), len(control)-degree+1);
}
test_nurbs_curve_breaks_default_length_matches_formula();
'''

[[test]]
name = "test_nurbs_curve_breaks_open_type_domain"
script = '''
include <../std.scad>
include <../nurbs.scad>

module test_nurbs_curve_breaks_open_type_domain() {
    control = [[5,0],[0,20],[33,43],[37,88],[60,62],[44,22],[77,44],[79,22],[44,3],[22,7]];
    degree = 2;
    breaks = nurbs_curve_breaks(control, degree, type="open");
    assert(is_increasing(breaks));
    assert_approx(breaks[0], 0);
    assert_approx(last(breaks), 1);
}
test_nurbs_curve_breaks_open_type_domain();
'''

# ---------------------------------------------------------------------
# nurbs_length()
# ---------------------------------------------------------------------

[[test]]
name = "test_nurbs_length"
script = '''
include <../std.scad>
include <../nurbs.scad>

module test_nurbs_length_degree1_polyline_is_exact() {
    // A degree-1 clamped B-spline is a polyline, so its length is exactly
    // the sum of the segment lengths between consecutive control points.
    control = [[0,0],[3,4],[6,4],[10,4]];
    expected = norm([3,4]-[0,0]) + norm([6,4]-[3,4]) + norm([10,4]-[6,4]);  // 5+3+4 = 12
    assert_approx(nurbs_length(control, 1), expected, 1e-9);
}
test_nurbs_length_degree1_polyline_is_exact();
'''

[[test]]
name = "test_nurbs_length_zero_for_degenerate_interval"
script = '''
include <../std.scad>
include <../nurbs.scad>

module test_nurbs_length_zero_for_degenerate_interval() {
    control = [[5,0],[0,20],[33,43],[37,88],[60,62],[44,22],[77,44],[79,22],[44,3],[22,7]];
    assert_equal(nurbs_length(control, 2, start_u=0.3, end_u=0.3), 0);
}
test_nurbs_length_zero_for_degenerate_interval();
'''

[[test]]
name = "test_nurbs_length_is_monotonic_in_end_u"
script = '''
include <../std.scad>
include <../nurbs.scad>

module test_nurbs_length_is_monotonic_in_end_u() {
    // Arc length is the integral of a non-negative speed, so it can only
    // grow (or stay flat) as the upper bound advances.
    control = [[5,0],[0,20],[33,43],[37,88],[60,62],[44,22],[77,44],[79,22],[44,3],[22,7]];
    degree = 2;
    short = nurbs_length(control, degree, end_u=0.3);
    long  = nurbs_length(control, degree, end_u=0.7);
    full  = nurbs_length(control, degree, end_u=1);
    assert(short < long);
    assert(long < full);
}
test_nurbs_length_is_monotonic_in_end_u();
'''

[[test]]
name = "test_nurbs_length_rational_semicircle_matches_pi"
script = '''
include <../std.scad>
include <../nurbs.scad>

module test_nurbs_length_rational_semicircle_matches_pi() {
    control = [[1,0],[1,2],[-1,2],[-1,0]];
    w = [1,1/3,1/3,1];
    len = nurbs_length(control, 3, weights=w);
    assert(approx(len, PI, 1e-4));
}
test_nurbs_length_rational_semicircle_matches_pi();
'''

[[test]]
name = "test_nurbs_length_rational_full_circle_matches_two_pi"
script = '''
include <../std.scad>
include <../nurbs.scad>

module test_nurbs_length_rational_full_circle_matches_two_pi() {
    // Two glued semicircles (clamped, with a multiplicity-3 interior knot)
    // form a full unit circle.
    control = [[1,0],[1,2],[-1,2],[-1,0],[-1,-2],[1,-2],[1,0]];
    w = [1,1/3,1/3,1,1/3,1/3,1];
    len = nurbs_length(control, 3, weights=w, mult=[1,3,1]);
    assert(approx(len, 2*PI, 1e-4));
}
test_nurbs_length_rational_full_circle_matches_two_pi();
'''

[[test]]
name = "test_nurbs_length_closed_type_circle_matches_two_pi"
script = '''
include <../std.scad>
include <../nurbs.scad>

module test_nurbs_length_closed_type_circle_matches_two_pi() {
    control = [[1,0],[1,2],[-1,2],[-1,0],[-1,-2],[1,-2]];
    w = [1,1/3,1/3,1,1/3,1/3];
    len = nurbs_length(control, 3, weights=w, mult=[1,3,3], type="closed");
    assert(approx(len, 2*PI, 1e-4));
}
test_nurbs_length_closed_type_circle_matches_two_pi();
'''

[[test]]
name = "test_nurbs_length_closed_wrap_sums_to_total"
script = '''
include <../std.scad>
include <../nurbs.scad>

module test_nurbs_length_closed_wrap_sums_to_total() {
    pts = [[13,43],[30,52],[49,22],[24,3]];
    degree = 2;
    full       = nurbs_length(pts, degree, type="closed");
    wrap_part  = nurbs_length(pts, degree, type="closed", start_u=0.75, end_u=0.25);
    other_part = nurbs_length(pts, degree, type="closed", start_u=0.25, end_u=0.75);
    assert(approx(wrap_part + other_part, full, 1e-4*(1+abs(full))));
}
test_nurbs_length_closed_wrap_sums_to_total();
'''

[[test]]
name = "test_nurbs_length_param_list_form_matches_direct_call"
script = '''
include <../std.scad>
include <../nurbs.scad>

module test_nurbs_length_param_list_form_matches_direct_call() {
    control = [[13,43],[30,52],[49,22],[24,3]];
    degree = 2;
    direct = nurbs_length(control, degree);
    plist = ["clamped", degree, control, undef, undef, undef];
    via_list = nurbs_length(plist);
    assert_approx(direct, via_list);
}
test_nurbs_length_param_list_form_matches_direct_call();
'''

