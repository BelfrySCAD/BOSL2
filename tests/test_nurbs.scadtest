# ---------------------------------------------------------------------
# nurbs_find_u()
# ---------------------------------------------------------------------

[[test]]
name = "test_nurbs_find_u"
script = '''
include <../std.scad>
include <../nurbs.scad>

module test_nurbs_find_u_degree1_forward_exact() {
    // On a degree-1 (polyline) curve, travelling 2 units forward along the
    // first segment (length 5, from [0,0] to [3,4]) lands 2/5 of the way in.
    control = [[0,0],[3,4],[6,4],[10,4]];
    degree = 1;
    u = nurbs_find_u(2, control, degree);
    assert(approx(u,2/15,eps=1e-7));    
    pt = nurbs_curve(control, degree, u=u);
    assert(approx(pt, [1.2,1.6],1e-6));    
}
test_nurbs_find_u_degree1_forward_exact();
'''

[[test]]
name = "test_nurbs_find_u_degree1_backward_exact"
script = '''
include <../std.scad>
include <../nurbs.scad>

module test_nurbs_find_u_degree1_backward_exact() {
    // Starting at control point index 2 ([6,4], u=2/3) and going backward
    // exactly the length of the preceding segment (3) lands exactly on
    // control point index 1 ([3,4], u=1/3).
    control = [[0,0],[3,4],[6,4],[10,4]];
    degree = 1;
    u = nurbs_find_u(-3, control, degree, start_u=2/3);
    assert(approx(u, 1/3,1e-7));
    pt = nurbs_curve(control, degree, u=u);
    assert(approx(pt, [3,4],1e-6));    
}
test_nurbs_find_u_degree1_backward_exact();
'''

