[[test]]
name = "test_nurbs_curve_closed_close_loop_param"
script = '''
include <../std.scad>
include <../nurbs.scad>

module test_nurbs_curve_closed_close_loop_param() {
    control = [[5,0],[0,20],[33,43],[37,88],[60,62],[44,22],[77,44],[79,22],[44,3],[22,7]];
    degree = 3;
    ss = 5;
    curve_open  = nurbs_curve(control, degree, splinesteps=ss, type="closed");
    curve_close = nurbs_curve(control, degree, splinesteps=ss, type="closed", close_loop=true);
    assert_equal(len(curve_close), len(curve_open) + 1);
    assert_approx(curve_close[0], last(curve_close));
    assert(!approx(curve_open[0], last(curve_open)));
}
test_nurbs_curve_closed_close_loop_param();
'''

[[test]]
name = "test_nurbs_curve_rational_semicircle_is_on_unit_circle"
script = '''
include <../std.scad>
include <../nurbs.scad>

module test_nurbs_curve_rational_semicircle_is_on_unit_circle() {
    control = [[1,0],[1,2],[-1,2],[-1,0]];
    w = [1,1/3,1/3,1];
    pts = nurbs_curve(control, 3, u=[0,0.25,0.5,0.75,1], weights=w);
    for (p = pts)
        assert(approx(norm(p), 1, 1e-6));
    assert_approx(pts[0], [1,0]);
    assert_approx(pts[4], [-1,0]);
}
test_nurbs_curve_rational_semicircle_is_on_unit_circle();
'''

[[test]]
name = "test_nurbs_curve_glued_circle_closes_up"
script = '''
include <../std.scad>
include <../nurbs.scad>

module test_nurbs_curve_glued_circle_closes_up() {
    // Two semicircular rational NURBS segments glued with a multiplicity-3 knot
    // form a full circle (see nurbs_curve() docs example).
    control = [[1,0],[1,2],[-1,2],[-1,0],[-1,-2],[1,-2],[1,0]];
    w = [1,1/3,1/3,1,1/3,1/3,1];
    pts = nurbs_curve(control, 3, u=[0,0.25,0.5,0.75,1], weights=w, mult=[1,3,1]);
    for (p = pts)
        assert(approx(norm(p), 1, 1e-6));
    assert_approx(pts[0], pts[4]);
}
test_nurbs_curve_glued_circle_closes_up();
'''

