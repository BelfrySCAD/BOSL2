[[test]]
name = "test_nurbs_curve_knot_reparam_invariance"
script = '''
include <../std.scad>
include <../nurbs.scad>

module test_nurbs_curve_knot_reparam_invariance() {
    // Explicit knots with the same *relative* spacing as the uniform default,
    // but a different absolute range, should not change the curve's shape:
    // u is always renormalized to the actual knot domain.
    control = [[13,43],[30,52],[49,22],[24,3]];
    degree = 2;
    default_curve = nurbs_curve(control, degree, splinesteps=5);
    custom_curve  = nurbs_curve(control, degree, splinesteps=5, knots=[0,10,20]);
    assert_approx(default_curve, custom_curve);
}
test_nurbs_curve_knot_reparam_invariance();
'''

[[test]]
name = "test_nurbs_curve_mult_creates_corner"
script = '''
include <../std.scad>
include <../nurbs.scad>

module test_nurbs_curve_mult_creates_corner() {
    // A knot of multiplicity == degree creates a corner (C^0 only) in a
    // quadratic curve, per the docs' worked example.
    pts = [[5,0],[0,20],[33,43],[37,88],[60,62],[44,22],[77,44],[79,22],[44,3],[22,7]];
    mult = [1,1,1,2,1,1,1,1];
    degree = 2;
    ucorner = 3/7;

    d1 = nurbs_curve(pts, degree, u=ucorner, mult=mult, deriv=1);
    assert(is_nan(d1));

    d1_two = nurbs_curve(pts, degree, u=ucorner, mult=mult, deriv=1, two_sided=true);
    assert_equal(len(d1_two), 2);
    assert(!approx(d1_two[0], d1_two[1]));

    // the point itself (0th derivative) is always well-defined and unaffected
    pt = nurbs_curve(pts, degree, u=ucorner, mult=mult);
    pt_via_deriv0 = nurbs_curve(pts, degree, u=ucorner, mult=mult, deriv=0);
    assert_approx(pt, pt_via_deriv0);
}
test_nurbs_curve_mult_creates_corner();
'''

[[test]]
name = "test_nurbs_curve_deriv_list_matches_individual_calls"
script = '''
include <../std.scad>
include <../nurbs.scad>

module test_nurbs_curve_deriv_list_matches_individual_calls() {
    control = [[5,0],[0,20],[33,43],[37,88],[60,62],[44,22],[77,44],[79,22],[44,3],[22,7]];
    degree = 3;
    uvals = [0.1, 0.37, 0.6, 0.85];

    combined = nurbs_curve(control, degree, u=uvals, deriv=[0,1,2]);
    pts = nurbs_curve(control, degree, u=uvals, deriv=0);
    d1  = nurbs_curve(control, degree, u=uvals, deriv=1);
    d2  = nurbs_curve(control, degree, u=uvals, deriv=2);

    assert_equal(len(combined), 3);
    assert_approx(combined[0], pts);
    assert_approx(combined[1], d1);
    assert_approx(combined[2], d2);
}
test_nurbs_curve_deriv_list_matches_individual_calls();
'''

[[test]]
name = "test_nurbs_curve_deriv_scalar_u_list_form"
script = '''
include <../std.scad>
include <../nurbs.scad>

module test_nurbs_curve_deriv_scalar_u_list_form() {
    // With scalar u and a list of derivative orders, the result should be a
    // flat list of single entries (one per order), not a list of lists.
    control = [[5,0],[0,20],[33,43],[37,88],[60,62],[44,22],[77,44],[79,22],[44,3],[22,7]];
    degree = 3;
    u0 = 0.42;
    result = nurbs_curve(control, degree, u=u0, deriv=[0,1]);
    assert_equal(len(result), 2);
    assert(is_vector(result[0]));
    assert(is_vector(result[1]));
}
test_nurbs_curve_deriv_scalar_u_list_form();
'''

[[test]]
name = "test_nurbs_curve_deriv_matches_finite_difference"
script = '''
include <../std.scad>
include <../nurbs.scad>

module test_nurbs_curve_deriv_matches_finite_difference() {
    // At a smooth, non-knot interior point the analytic first derivative
    // should agree with a central finite difference.
    control = [[5,0],[0,20],[33,43],[37,88],[60,62],[44,22],[77,44],[79,22],[44,3],[22,7]];
    degree = 3;
    u0 = 0.42;
    h = 1e-5;
    p_minus = nurbs_curve(control, degree, u=u0-h);
    p_plus  = nurbs_curve(control, degree, u=u0+h);
    fd = (p_plus - p_minus)/(2*h);
    analytic = nurbs_curve(control, degree, u=u0, deriv=1);
    assert(approx(fd, analytic, 1e-2));
}
test_nurbs_curve_deriv_matches_finite_difference();
'''

[[test]]
name = "test_nurbs_curve_deriv_endpoint_is_one_sided_not_nan"
script = '''
include <../std.scad>
include <../nurbs.scad>

module test_nurbs_curve_deriv_endpoint_is_one_sided_not_nan() {
    // At a clamped curve's domain endpoints only one side of the curve
    // exists; that one-sided derivative should be returned directly,
    // never NAN, even though the endpoint sits on a full-multiplicity knot.
    control = [[13,43],[30,52],[49,22],[24,3]];
    degree = 2;
    d0 = nurbs_curve(control, degree, u=0, deriv=1);
    d1 = nurbs_curve(control, degree, u=1, deriv=1);
    assert(!is_nan(d0));
    assert(!is_nan(d1));
}
test_nurbs_curve_deriv_endpoint_is_one_sided_not_nan();
'''

