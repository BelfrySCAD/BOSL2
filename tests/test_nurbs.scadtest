}
test_nurbs_find_u_backward_roundtrip_matches_length();
'''

[[test]]
name = "test_nurbs_find_u_full_circle_wraps_to_start_point"
script = '''
include <../std.scad>
include <../nurbs.scad>

module test_nurbs_find_u_full_circle_wraps_to_start_point() {
    control = [[1,0],[1,2],[-1,2],[-1,0],[-1,-2],[1,-2]];
    w = [1,1/3,1/3,1,1/3,1/3];
    degree = 3;
    mult = [1,3,3];
    total = nurbs_length(control, degree, weights=w, mult=mult, type="closed");
    u = nurbs_find_u(total, control, degree, weights=w, mult=mult, type="closed", start_u=0);
    pt = nurbs_curve(control, degree, u=u, weights=w, mult=mult, type="closed");
    assert(approx(pt, [1,0], 1e-3));
}
test_nurbs_find_u_full_circle_wraps_to_start_point();
'''

[[test]]
name = "test_nurbs_find_u_param_list_form_matches_direct_call"
script = '''
