[[test]]
name = "test_nurbs_curve_splinesteps_point_count"
script = '''
include <../std.scad>
include <../nurbs.scad>

module test_nurbs_curve_splinesteps_point_count() {
    // Clamped, uniform, 4 control points, degree 2: 2 knot spans.
    control = [[0,0],[1,2],[2,2],[3,0]];
    degree = 2;
    ss = 4;
    curve = nurbs_curve(control, degree, splinesteps=ss);
    expected_len = (len(control)-degree)*ss + 1;
    assert_equal(len(curve), expected_len);
    assert_approx(last(curve), last(control));
}
test_nurbs_curve_splinesteps_point_count();
'''

