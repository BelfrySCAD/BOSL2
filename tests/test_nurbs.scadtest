name = "test_nurbs_curve_breaks_closed_includes_both_ends"
script = '''
include <../std.scad>
include <../nurbs.scad>

module test_nurbs_curve_breaks_closed_includes_both_ends() {
    // For type="closed" both 0 and 1 should appear, representing the
    // same geometric seam point.
    control = [[1,0],[1,2],[-1,2],[-1,0],[-1,-2],[1,-2]];
    degree = 3;
    breaks = nurbs_curve_breaks(control, degree, mult=[1,3,3], type="closed");
    assert_approx(breaks[0], 0);
    assert_approx(last(breaks), 1);
}
test_nurbs_curve_breaks_closed_includes_both_ends();
'''

