}
test_nurbs_find_u_zero_distance_returns_start_u();
'''

[[test]]
name = "test_nurbs_find_u_forward_roundtrip_matches_length"
script = '''
include <../std.scad>
include <../nurbs.scad>

module test_nurbs_find_u_forward_roundtrip_matches_length() {
    control = [[5,0],[0,20],[33,43],[37,88],[60,62],[44,22],[77,44],[79,22],[44,3],[22,7]];
    degree = 2;
    u = nurbs_find_u(50, control, degree);
    got = nurbs_length(control, degree, end_u=u);
    assert(approx(got, 50, 1e-3));
}
test_nurbs_find_u_forward_roundtrip_matches_length();
'''

