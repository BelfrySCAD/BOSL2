[[test]]
name = "test_hsl"
script = '''
include <../std.scad>

module test_hsl() {
    for (h = [0:30:360]) {
        for (s = [0:0.2:1]) {
            for (l = [0:0.2:1]) {
                c = (1 - abs(2*l-1)) * s;
                x = c * (1 - abs(((h/60)%2)-1));
                m = l - c/2;
                rgb = [m,m,m] + (
                    h<= 60? [c,x,0] :
                    h<=120? [x,c,0] :
                    h<=180? [0,c,x] :
                    h<=240? [0,x,c] :
                    h<=300? [x,0,c] :
                            [c,0,x]
                );
                assert_approx(hsl(h,s,l), rgb, format("h={}, s={}, l={}", [h,s,l]));
            }
        }
    }
}
test_hsl();
'''

[[test]]
name = "test_hsv"
script = '''
include <../std.scad>

module test_hsv() {
    for (h = [0:30:360]) {
        for (s = [0:0.2:1]) {
            for (v = [0:0.2:1]) {
                c = v * s;
                x = c * (1 - abs(((h/60)%2)-1));
                m = v - c;
                rgb = [m,m,m] + (
                    h<= 60? [c,x,0] :
                    h<=120? [x,c,0] :
                    h<=180? [0,c,x] :
                    h<=240? [0,x,c] :
                    h<=300? [x,0,c] :
                            [c,0,x]
                );
                assert_approx(hsv(h,s,v), rgb, format("h={}, s={}, v={}", [h,s,v]));
            }
        }
    }
}
test_hsv();
'''


[[test]]
name = "test_lch"
script = '''
include <../std.scad>

assert_approx(lch(l=0, c=0, h=0), [0, 0, 0]);

assert(approx(lch(l=1, c=0, h=137), [1, 1, 1],1e-6));

// Hue is irrelevant when chroma is zero.
assert_approx(lch(l=.5, c=0, h=0),
              lch(l=.5, c=0, h=137));

// Hue is periodic.
assert_approx(lch(l=.5, c=40, h=0),
              lch(l=.5, c=40, h=360));

// sat=1 gives the maximum in-gamut chroma.
assert_approx(
    lch(l=.5, sat=1, h=120),
    lch(l=.5, c=max_chroma(.5,120), h=120)
);
'''


[[test]]
name = "test_lch"
expect_success = false
script = '''
include <../std.scad>

lch(l=.5, c=max_chroma(.5,120)*1.01, h=120);

'''


[[test]]
name = "test_max_chroma"
script = '''
include <../std.scad>


// max_chroma()
assert_approx(max_chroma(0, 0), 0);

assert_approx(max_chroma(1, 137), 0);

// There is nonzero chroma available in the interior of the gamut.
assert(max_chroma(.5, 0) > 0);

// The computed maximum lies on the gamut boundary.
let(
    l = .5,
    h = 0,
    c = max_chroma(l,h)
)
assert_approx(_gamut_violation(h,c,l), 0);

// Slightly below the maximum must remain in gamut.
let(
    l = .5,
    h = 120,
    c = max_chroma(l,h)
)
assert(_gamut_violation(h,c*.999,l) <= 0);
'''




