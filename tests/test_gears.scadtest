[[test]]
name = "test_stepped_planetary"
expect_success = true
assert_no_echoes = true
assert_no_warnings = true
script = '''
include <../std.scad>
include <../gears.scad>
module test_stepped_planetary() {
    a = stepped_planetary(4,40,mod1=1,sun_carrier=6,exact=true,uniform=true);
    b = stepped_planetary(4,40,mod1=1,sun_carrier=6,exact=true,uniform=true,gear_spin=120);
    assert([a[0][1],a[2][1][0],a[2][1][1],a[1][1]]==[8,8,8,40],
           "\nWrong minimum-diameter exact layout");
    assert(approx(a[3][1],6), "\nWrong sun/carrier ratio");
    assert(norm(a[4][1]-[1,0.5])<1e-8, "\nWrong module sizes");
    assert(norm(a[2][5]-[0,90,180,270])<1e-8, "\nWrong uniform planet angles");
    assert(approx(b[0][3]-a[0][3],120), "\nWrong sun motion");
    assert(approx(b[1][3],a[1][3]), "\nFixed ring moved");
    assert(norm(b[2][5]-a[2][5]-[20,20,20,20])<1e-8, "\nWrong carrier motion");
    assert(norm(b[2][3]-a[2][3]+[80,80,80,80])<1e-8, "\nWrong planet spin");
    for(i=[0:3])
        assert(norm(b[2][4][i]-rot(20,p=a[2][4][i]))<1e-8, "\nWrong planet position");
    c = stepped_planetary(4,40,mod1=1,sun_carrier=[5.7,6.3],uniform=true);
    assert(c[3][1]>=5.7 && c[3][1]<=6.3, "\nRatio outside requested interval");
}
test_stepped_planetary();
'''


