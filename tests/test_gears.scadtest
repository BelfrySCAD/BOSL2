[[test]]
name = "test_globoid_worm_max_length"
script = '''
include <../std.scad>
include <../gears.scad>

module test_globoid_worm_max_length() {
    m=2; N=55; d=24; s=5;
    cb = sqrt(1-pow(s*m/d,2));
    R = m*N/(2*cb);
    // default clearance is module/4
    assert_approx(globoid_worm_max_length(mod=m, teeth=N, d=d, starts=s),
                  1.3*(R-m-m/4));
    // explicit clearance reduces the limit
    assert_approx(globoid_worm_max_length(mod=m, teeth=N, d=d, starts=s, clearance=1),
                  1.3*(R-m-1));
    assert(globoid_worm_max_length(mod=m, teeth=N, d=d, starts=s, clearance=1)
           < globoid_worm_max_length(mod=m, teeth=N, d=d, starts=s));
    // aliases
    assert_approx(globoid_worm_max_length(mod=m, teeth=N, worm_diam=d, worm_starts=s),
                  globoid_worm_max_length(mod=m, teeth=N, d=d, starts=s));
}
test_globoid_worm_max_length();
'''

[[test]]
name = "test_globoid_worm_outer_radius"
script = '''
include <../std.scad>
include <../gears.scad>

module test_globoid_worm_outer_radius() {
    // At the throat the outer radius is pitch radius plus module
    assert_approx(globoid_worm_outer_radius(mod=3, d=20, teeth=22, z=0), 13);
    // Radius grows away from the middle
    r2 = globoid_worm_outer_radius(mod=3, d=20, teeth=22, z=2);
    r5 = globoid_worm_outer_radius(mod=3, d=20, teeth=22, z=5);
    assert(r2 > 13);
    assert(r5 > r2);
    // Symmetric about the middle plane
    assert_approx(globoid_worm_outer_radius(mod=3, d=20, teeth=22, z=-5), r5);
    // Default z is half the worm length
    assert_approx(globoid_worm_outer_radius(mod=3, d=20, teeth=22, worm_length=10), r5);
}
test_globoid_worm_outer_radius();
'''

[[test]]
name = "test_worm_gear_radius_bound"
script = '''
include <../std.scad>
include <../gears.scad>

module test_worm_gear_radius_bound() {
    m=2; N=25; d=30; t=12;
    b = worm_gear_radius_bound(mod=m, teeth=N, thickness=t, worm_diam=d);
    expected = worm_dist(mod=m, teeth=N, worm_diam=d) - sqrt(pow(d/2-m,2)-pow(t/2,2));
    assert_approx(b, expected);
    // Bound must exceed the pitch radius
    assert(b > N*m/2);
    // aliases
    assert_approx(worm_gear_radius_bound(mod=m, teeth=N, thickness=t, d=d), b);
    // Thicker gear gives a larger bound
    assert(worm_gear_radius_bound(mod=m, teeth=N, thickness=16, worm_diam=d) > b);
}
test_worm_gear_radius_bound();
'''

[[test]]
name = "test_globoid_worm_gear_radius_bound"
script = '''
include <../std.scad>
include <../gears.scad>

module test_globoid_worm_gear_radius_bound() {
    m=2; N=55; d=24; s=5; L=35; t=12;
    b = globoid_worm_gear_radius_bound(mod=m, teeth=N, thickness=t, d=d, starts=s, length=L);
    R = m*N/(2*sqrt(1-pow(s*m/d,2)));
    a = R+d/2;
    H = L/2;
    r = a-sqrt(pow(R+m,2)-H*H);
    expected = sqrt(pow(a-sqrt(r*r-t*t/4),2)+H*H);
    assert_approx(b, expected);
    assert(b > R);
    // length aliases agree
    assert_approx(globoid_worm_gear_radius_bound(mod=m, teeth=N, thickness=t, worm_diam=d,
                                                 worm_starts=s, worm_length=L), b);
    // "max" selects the maximum supported length
    Lmax = globoid_worm_max_length(mod=m, teeth=N, d=d, starts=s);
    assert_approx(globoid_worm_gear_radius_bound(mod=m, teeth=N, thickness=t, d=d, starts=s, length="max"),
                  globoid_worm_gear_radius_bound(mod=m, teeth=N, thickness=t, d=d, starts=s, length=Lmax));
}
test_globoid_worm_gear_radius_bound();
'''

[[test]]
name = "test_globoid_worm_pressure_angle_limit"
script = '''
include <../std.scad>
include <../gears.scad>

limit = globoid_worm_pressure_angle_limit(.1,mod=2,teeth=20,worm_diam=16,clearance=.5);
assert(is_finite(limit) && limit>40 && limit<50);
// A uniform change of length units must not change the angular limit.
assert_approx(globoid_worm_pressure_angle_limit(.1,mod=6,teeth=20,worm_diam=48,clearance=1.5),limit);
assert_approx(globoid_worm_pressure_angle_limit(.1,circ_pitch=2*PI,mate_teeth=20,d=16,starts=1,clearance=.5),limit);
assert_approx(globoid_worm_pressure_angle_limit(.1,mod=2,teeth=20,worm_root_diam=11,clearance=.5),limit);
assert(globoid_worm_pressure_angle_limit(.1,mod=2,teeth=20,worm_diam=16,clearance=.2)>limit);
assert(globoid_worm_pressure_angle_limit(20,mod=2,teeth=20,worm_diam=16,clearance=.5)<limit);
assert(is_undef(globoid_worm_pressure_angle_limit(89,mod=2,teeth=20,worm_diam=16)));
multi = globoid_worm_pressure_angle_limit(.1,mod=2,teeth=20,worm_diam=16,worm_starts=3);
assert(is_finite(multi) && multi>0 && multi<90);
'''

