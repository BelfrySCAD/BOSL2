[[test]]
name = "test_globoid_worm_radius_bound"
expect_success = true
assert_no_echoes = true
assert_no_warnings = true
script = '''
include <../std.scad>
include <../gears.scad>
module test_globoid_worm_radius_bound() {
    r = globoid_worm_radius_bound(mod=2,teeth=55,d=24,starts=5,length=60);
    assert(approx(r,19.794968821870803,1e-8), "\nWrong default 32-interval bound");
    assert(approx(r,globoid_worm_radius_bound(mod=2,55,24,starts=5,l=60,steps=32)), "\nAliases differ");
    assert(approx(2*r,globoid_worm_radius_bound(mod=4,teeth=55,d=48,starts=5,length=120)), "\nScaling failed");
    assert(approx(globoid_worm_radius_bound(mod=2,teeth=55,d=24,starts=5,length=60,lead_in=0),
                  20.25488918556563,1e-8), "\nWrong untapered bound");
}
test_globoid_worm_radius_bound();
'''
