[[test]]
name = "test_spur_gear_herringbone"
script = '''
include <../std.scad>
include <../gears.scad>

module test_spur_gear_herringbone() {
    $fn = 4;
    // How far the top face's points are from the bottom face's, seen from above.
    function ends_apart(vnf) = let(
        zs = [for (p = vnf[0]) p.z],
        top = [for (p = vnf[0]) if (approx(p.z, max(zs))) point2d(p)],
        bot = [for (p = vnf[0]) if (approx(p.z, min(zs))) point2d(p)]
    ) max([for (p = top) min([for (q = bot) norm(p - q)])]);
    // A herringbone gear's ends are twisted the same way from its middle, so its top face is its bottom face moved up.
    assert(ends_apart(spur_gear(mod=2, teeth=12, thickness=10, helical=30, herringbone=true)) < 1e-6);
    // A helical gear's ends are twisted opposite ways.
    assert(ends_apart(spur_gear(mod=2, teeth=12, thickness=10, helical=30)) > 0.1);
}
test_spur_gear_herringbone();
'''

[[test]]
name = "test_rack2d"
script = '''
include <../std.scad>
include <../gears.scad>

module test_rack2d() {
    // rack2d uses 'backing' for underside height, not 'height'
    v = rack2d(mod=2, teeth=5, backing=5);
    assert(is_path(v, 2) || is_region(v));
}
test_rack2d();
'''

[[test]]
name = "test_rack"
assert_no_echoes = false
script = '''
include <../std.scad>
include <../gears.scad>

module test_rack() {
    // rack uses 'backing' for underside height
    // herringbone=true uses sweep() instead of linear_sweep(), avoiding anchor bug
    v = rack(mod=2, teeth=10, thickness=5, backing=5, helical=20, herringbone=true);
    assert(is_vnf(v));
    assert(len(v[0]) > 0);
    // Teeth point UP, the thickness runs along Y and the end faces are shifted toward -X, as in the module form.
    hl = 10*PI/cos(20);  // half length
    shift = 2.5*tan(20);
    assert_approx(pointlist_bounds(v[0]), [[-hl-shift, -2.5, -7.5], [hl, 2.5, 2]]);
    back_face = [for (p=v[0]) if (approx(p.y, 2.5)) p];
    assert_approx(min(column(back_face,0)), -hl-shift);
}
test_rack();
'''

[[test]]
name = "test_planetary_gears"
script = '''
include <../std.scad>
include <../gears.scad>

module test_planetary_gears() {
    // Returns [["sun", z, ps, spin], ["ring", ...], ["planets", ...], ["ratio", ...]]
    result = planetary_gears(n=3, max_teeth=50, mod=2, ring_carrier=1.5);
    assert(is_list(result));
    assert(len(result) == 4);
    // First entry is sun gear info, second is ring, third is planets, fourth is ratio
    assert(result[0][0] == "sun");
    assert(result[1][0] == "ring");
    assert(result[3][0] == "ratio");
    // Tooth counts are positive integers
    assert(is_int(result[0][1]) && result[0][1] > 0);
    assert(is_int(result[1][1]) && result[1][1] > 0);
}
test_planetary_gears();
'''

